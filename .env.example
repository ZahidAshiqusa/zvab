PREFIX=.
COMMAND_MODE=public
TIMEZONE=Asia/Karachi
SESSION_ID=

# ── WHATSAPP AUTOMATION TOGGLES (ALL TRUE BY DEFAULT) ────────
AUTOREAD=true
AUTOTYPE=true
AUTORECORD=true
AUTORECORDTYPE=true
AUTO_STATUS_REACT=true
AUTO_STATUS_REPLY=true
AUTO_STATUS_MSG=Status Viewed by Urooj Choudhary
